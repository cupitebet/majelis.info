# ============================================
# DEPLOYMENT STRATEGY: CHILD THEME + CUSTOM FILES ONLY
# WordPress core, plugins, dan parent theme TIDAK di-commit
# ============================================

# WordPress CORE - EXCLUDE dari Git
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
index.php

# WordPress CONFIG - EXCLUDE (sensitive)
wp-config.php
wp-config-local.php
wp-config-sample.php
.htaccess
.htaccess.backup

# WordPress UPLOADS & CACHE - EXCLUDE (terlalu besar)
wp-content/uploads/
wp-content/uploadpath.php
wp-content/cache/
wp-content/backups/
wp-content/backup*/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/object-cache.php

# WordPress PLUGINS - EXCLUDE SEMUA (kecuali custom plugins)
wp-content/plugins/*
!wp-content/plugins/.gitkeep
# Jika ada custom plugin, uncomment:
# !wp-content/plugins/my-custom-plugin/

# WordPress THEMES - EXCLUDE parent themes
wp-content/themes/twenty*/
wp-content/themes/meup/
# HANYA COMMIT meup-child (custom theme)
!wp-content/themes/meup-child/

# WordPress MU-Plugins - EXCLUDE kecuali custom
wp-content/mu-plugins/*
!wp-content/mu-plugins/.gitkeep

# WP Rocket & Caching plugins
wp-content/cache/
wp-content/wp-rocket-config/
wp-content/wflogs/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/
*.log.*

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
tmp/
temp/
cache/

# Database backups
*.sql
*.sql.gz
*.sql.zip

# Sensitive data
config.php
database.php
credentials.json

# Node modules (jika ada)
node_modules/
npm-debug.log
yarn-error.log

# PHP dependencies
vendor/
composer.lock

# Build files
dist/
build/

# WP-ENV
.wp-env/
.wp-env.override.json
.wp-env.json.bak

# Test artifacts
.phpunit.result.cache
coverage/
